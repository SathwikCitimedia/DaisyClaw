<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DaisyClaw.SetupEngine.UI.Pages.NativeGatewayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Disabled">

    <Grid Padding="48,28,48,24" RowDefinitions="Auto,*,Auto">

        <StackPanel Grid.Row="0" Spacing="8" HorizontalAlignment="Center">
            <Image Source="ms-appx:///DaisyClaw.SetupEngine.UI/Assets/Setup/DaisyClawMascot.png"
                   Width="44" Height="44" HorizontalAlignment="Center"
                   AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Text="Run Daisy on this PC"
                       Style="{StaticResource TitleTextBlockStyle}"
                       TextAlignment="Center" HorizontalAlignment="Center" />
            <TextBlock TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Text="Daisy Assistant connects to the DaisyClaw gateway running natively on this computer — no Linux, no virtual machines." />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="16" MaxWidth="520" VerticalAlignment="Top"
                    HorizontalAlignment="Stretch" Margin="0,32,0,0">

            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <ProgressRing x:Name="DetectProgress" Width="20" Height="20" IsActive="True" />
                <FontIcon x:Name="ResultIcon" Glyph="&#xE73E;" FontSize="20"
                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          IsTextScaleFactorEnabled="False"
                          Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                          Visibility="Collapsed" />
                <TextBlock x:Name="StatusText"
                           Text="Looking for your Daisy gateway…"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="DetailText"
                       TextWrapping="Wrap" TextAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" MaxWidth="460"
                       Text="" />

            <InfoBar x:Name="ErrorBar"
                     IsOpen="False"
                     Severity="Error"
                     IsClosable="False"
                     Title="Couldn't reach the Daisy gateway" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsTabStop="False" AutomationProperties.Name="Step 3 of 6">
                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{ThemeResource SetupInactiveDotBrush}" />
                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{ThemeResource SetupInactiveDotBrush}" />
                <Border Width="20" Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{ThemeResource SetupIndicatorAccentBrush}" />
                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{ThemeResource SetupInactiveDotBrush}" />
                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{ThemeResource SetupInactiveDotBrush}" />
                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{ThemeResource SetupInactiveDotBrush}" />
            </StackPanel>
            <Button x:Name="BackButton" AutomationProperties.AutomationId="NativeGatewayBackButton"
                    Grid.Column="0" Content="Back"
                    MinWidth="100" HorizontalAlignment="Left"
                    Click="Back_Click" />
            <Button x:Name="PrimaryButton" AutomationProperties.AutomationId="NativeGatewayPrimaryButton"
                    Grid.Column="1" Content="Continue"
                    MinWidth="100" HorizontalAlignment="Right"
                    IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="Primary_Click" />
        </Grid>
    </Grid>
</Page>
