<Project>

  <PropertyGroup>
    <DaisyClawVCRuntimePackageVersion>1.0.5</DaisyClawVCRuntimePackageVersion>
    <DaisyClawVCRuntimePackageRoot>$(NuGetPackageRoot)vcruntime.cefsharp.140\$(DaisyClawVCRuntimePackageVersion)\vc_redist\</DaisyClawVCRuntimePackageRoot>
    <DaisyClawVCRuntimeArch Condition="'$(RuntimeIdentifier)' == 'win-x64'">x64</DaisyClawVCRuntimeArch>
    <DaisyClawVCRuntimeArch Condition="'$(RuntimeIdentifier)' == 'win-arm64'">arm64</DaisyClawVCRuntimeArch>
  </PropertyGroup>

  <!--
    Both x64 and ARM64 resolve loose VC++ runtime DLLs from the local Visual
    Studio install at publish time (via ResolveDaisyClawVCRuntimeFromVSInstall).
    This ensures onnxruntime and other native dependencies always get a current
    CRT — the VCRuntime.CefSharp.140 NuGet ships 14.29 DLLs that are too old
    for onnxruntime ≥ 1.20.

    For local x64 *builds* (not publish), the NuGet DLLs are still copied to
    the output directory as a convenience so devs without VS can iterate.
    Local 'dotnet build -r win-arm64' intentionally does NOT require a VS
    install (so cross-compile sanity checks keep working on x64 dev boxes).
    The VS-install requirement only kicks in at publish time, which is what
    the release pipeline actually runs.
  -->
  <ItemGroup Condition="'$(DaisyClawVCRuntimeArch)' == 'x64'">
    <DaisyClawVCRuntimeFiles Include="$(DaisyClawVCRuntimePackageRoot)x64\*.dll" />
  </ItemGroup>

  <Target Name="ResolveDaisyClawVCRuntimeFromVSInstall"
          Condition="'$(DaisyClawVCRuntimeArch)' != ''">

    <PropertyGroup>
      <_DaisyClawVsWherePath>$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer\vswhere.exe</_DaisyClawVsWherePath>
    </PropertyGroup>

    <Error Condition="!Exists('$(_DaisyClawVsWherePath)')"
           Text="vswhere.exe not found at '$(_DaisyClawVsWherePath)'. Publishing requires a Visual Studio install with the C++ Redistributable (Microsoft.VisualStudio.Component.VC.Redist.14.Latest) component." />

    <Exec Command="&quot;$(_DaisyClawVsWherePath)&quot; -latest -products * -requires Microsoft.VisualStudio.Component.VC.Redist.14.Latest -property installationPath"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_DaisyClawVsInstallRoot" />
    </Exec>

    <!--
      Fallback: some VS installs carry the redist folder (via the C++ build
      tools) without registering the VC.Redist.14.Latest component id, so the
      -requires query above comes back empty. Take the latest VS install and
      let the "No VC++ Runtime DLLs were found" check below decide.
    -->
    <Exec Condition="'$(_DaisyClawVsInstallRoot)' == ''"
          Command="&quot;$(_DaisyClawVsWherePath)&quot; -latest -products * -property installationPath"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_DaisyClawVsInstallRoot" />
    </Exec>

    <Error Condition="'$(_DaisyClawVsInstallRoot)' == '' or !Exists('$(_DaisyClawVsInstallRoot)')"
           Text="vswhere did not find a Visual Studio install with the C++ Redistributable (Microsoft.VisualStudio.Component.VC.Redist.14.Latest) component (got '$(_DaisyClawVsInstallRoot)'). Install that component via the Visual Studio Installer (Individual Components tab)." />

    <!--
      Glob the loose CRT DLLs. The Microsoft.VC*.CRT folder name carries the VS
      major version (Microsoft.VC143.CRT for VS 2022, Microsoft.VC145.CRT for
      VS 18). There is at most one Microsoft.VC*.CRT subdir per arch per redist
      version, so the * collapses to a single match. We limit to
      vcruntime140*.dll + msvcp140*.dll to match the file set required by the
      native speech stack without carrying unrelated CRT DLLs.

      For x64 this replaces the stale NuGet-sourced items so publish always
      ships current DLLs from the VS install.
    -->
    <ItemGroup Condition="'$(DaisyClawVCRuntimeArch)' == 'x64'">
      <DaisyClawVCRuntimeFiles Remove="@(DaisyClawVCRuntimeFiles)" />
      <DaisyClawVCRuntimeFiles Include="$(_DaisyClawVsInstallRoot)\VC\Redist\MSVC\*\x64\Microsoft.VC*.CRT\vcruntime140*.dll" />
      <DaisyClawVCRuntimeFiles Include="$(_DaisyClawVsInstallRoot)\VC\Redist\MSVC\*\x64\Microsoft.VC*.CRT\msvcp140*.dll" />
    </ItemGroup>

    <ItemGroup Condition="'$(DaisyClawVCRuntimeArch)' == 'arm64'">
      <DaisyClawVCRuntimeFiles Include="$(_DaisyClawVsInstallRoot)\VC\Redist\MSVC\*\arm64\Microsoft.VC*.CRT\vcruntime140*.dll" />
      <DaisyClawVCRuntimeFiles Include="$(_DaisyClawVsInstallRoot)\VC\Redist\MSVC\*\arm64\Microsoft.VC*.CRT\msvcp140*.dll" />
    </ItemGroup>

    <Error Condition="'@(DaisyClawVCRuntimeFiles)' == ''"
           Text="No $(DaisyClawVCRuntimeArch) VC++ Runtime DLLs were found under '$(_DaisyClawVsInstallRoot)\VC\Redist\MSVC\*\$(DaisyClawVCRuntimeArch)\Microsoft.VC*.CRT\'. Install the C++ Redistributable Update Visual Studio component." />
  </Target>

  <!-- Legacy alias so existing CI log searches and docs still find the target. -->
  <Target Name="ResolveDaisyClawVCRuntimeArm64FromVSInstall"
          DependsOnTargets="ResolveDaisyClawVCRuntimeFromVSInstall" />

  <Target Name="CopyDaisyClawVCRuntimeToOutput"
          AfterTargets="Build"
          Condition="'$(DaisyClawVCRuntimeArch)' == 'x64' and '@(DaisyClawVCRuntimeFiles)' != ''">
    <!--
      x64-only on purpose. ARM64 publishes its runtime through the publish-only
      target below so that local 'dotnet build -r win-arm64' does not require
      a Visual Studio install.
      Uses the NuGet-sourced DLLs (the VS resolution only runs at publish).
    -->
    <Copy SourceFiles="@(DaisyClawVCRuntimeFiles)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyDaisyClawVCRuntimeToPublish"
          AfterTargets="Publish"
          DependsOnTargets="ResolveDaisyClawVCRuntimeFromVSInstall"
          Condition="'$(PublishDir)' != '' and '$(DaisyClawVCRuntimeArch)' != ''">
    <Copy SourceFiles="@(DaisyClawVCRuntimeFiles)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="ValidateDaisyClawVCRuntimePublished"
          AfterTargets="CopyDaisyClawVCRuntimeToPublish"
          Condition="'$(PublishDir)' != '' and '$(DaisyClawVCRuntimeArch)' != ''">
    <Error Condition="!Exists('$(PublishDir)vcruntime140.dll')"
           Text="vcruntime140.dll missing from $(PublishDir). Clean Windows installs cannot load native speech dependencies without the VC runtime." />
  </Target>

</Project>
